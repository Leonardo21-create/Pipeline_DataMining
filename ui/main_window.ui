              <property name="text">
               <string>K-Means (No Supervisado)</string>
              </property>
             </item>
            </widget>
           </item>

           <item row="1" column="0">
            <widget class="QLabel" name="lbl_validacion">
             <property name="text">
              <string>Tecnica de Validacion:</string>
             </property>
            </widget>
           </item>
           <item row="1" column="1">
            <widget class="QComboBox" name="cmb_validacion">
             <item>
              <property name="text">
               <string>Hold-out</string>
              </property>
             </item>
             <item>
              <property name="text">
               <string>Stratified K-Fold</string>
              </property>
             </item>
            </widget>
           </item>

           <item row="2" column="0">
            <widget class="QLabel" name="lbl_folds">
             <property name="text">
              <string>Numero de Folds (K):</string>
             </property>
            </widget>
           </item>
           <item row="2" column="1">
            <widget class="QSpinBox" name="spn_folds">
             <property name="minimum">
              <number>2</number>
             </property>
             <property name="maximum">
              <number>10</number>
             </property>
             <property name="value">
              <number>5</number>
             </property>
            </widget>
           </item>

           <item row="3" column="0">
            <widget class="QLabel" name="lbl_c">
             <property name="text">
              <string>Regularizacion (C):</string>
             </property>
            </widget>
           </item>
           <item row="3" column="1">
            <widget class="QDoubleSpinBox" name="spn_c">
             <property name="decimals">
              <number>2</number>
             </property>
             <property name="minimum">
              <double>0.010000000000000</double>
             </property>
             <property name="maximum">
              <double>100.000000000000000</double>
             </property>
             <property name="singleStep">
              <double>0.250000000000000</double>
             </property>
             <property name="value">
              <double>1.000000000000000</double>
             </property>
            </widget>
           </item>

           <item row="4" column="0">
            <widget class="QLabel" name="lbl_max_iter">
             <property name="text">
              <string>Iteraciones maximas:</string>
             </property>
            </widget>
           </item>
           <item row="4" column="1">
            <widget class="QSpinBox" name="spn_max_iter">
             <property name="minimum">
              <number>100</number>
             </property>
             <property name="maximum">
              <number>5000</number>
             </property>
             <property name="singleStep">
              <number>100</number>
             </property>
             <property name="value">
              <number>1000</number>
             </property>
            </widget>
           </item>

           <item row="5" column="0">
            <widget class="QLabel" name="lbl_clusters">
             <property name="text">
              <string>Clusters (K-Means):</string>
             </property>
            </widget>
           </item>
           <item row="5" column="1">
            <widget class="QSpinBox" name="spn_clusters">
             <property name="minimum">
              <number>2</number>
             </property>
             <property name="maximum">
              <number>10</number>
             </property>
             <property name="value">
              <number>2</number>
             </property>
            </widget>
           </item>
          </layout>
         </widget>
