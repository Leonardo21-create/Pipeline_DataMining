      <!-- PESTANA 3: PREPROCESAMIENTO -->
      <widget class="QWidget" name="tab_preprocesamiento">
       <attribute name="title">
        <string>3. Preprocesamiento</string>
       </attribute>
       <layout class="QVBoxLayout" name="layout_prep">
        <item>
         <layout class="QHBoxLayout" name="layout_prep_controles">
          <item>
           <widget class="QLabel" name="lbl_escalador">
            <property name="text">
             <string>Escalador:</string>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QComboBox" name="cmb_escalador">
            <item>
             <property name="text">
              <string>standard</string>
             </property>
            </item>
            <item>
             <property name="text">
              <string>minmax</string>
             </property>
            </item>
           </widget>
          </item>
          <item>
           <widget class="QLabel" name="lbl_test_size">
            <property name="text">
             <string>Proporcion Test (Hold-out):</string>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QDoubleSpinBox" name="spn_test_size">
            <property name="decimals">
             <number>2</number>
            </property>
            <property name="minimum">
             <double>0.100000000000000</double>
            </property>
            <property name="maximum">
             <double>0.400000000000000</double>
            </property>
            <property name="singleStep">
             <double>0.050000000000000</double>
            </property>
            <property name="value">
             <double>0.200000000000000</double>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QPushButton" name="btn_preprocesar">
            <property name="text">
             <string>Ejecutar Limpieza, Transformacion y Escalado</string>
            </property>
           </widget>
          </item>
         </layout>
        </item>

        <item>
         <layout class="QHBoxLayout" name="layout_prep_resumen" stretch="1,1">
          <item>
           <widget class="QGroupBox" name="grp_resumen_prep">
