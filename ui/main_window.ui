      <!-- PESTANA 2: ENTENDIMIENTO E INTEGRACION -->
      <widget class="QWidget" name="tab_datos">
       <attribute name="title">
        <string>2. Datos e Integracion</string>
       </attribute>
       <layout class="QVBoxLayout" name="layout_datos">
        <item>
         <layout class="QHBoxLayout" name="layout_archivos">
          <item>
