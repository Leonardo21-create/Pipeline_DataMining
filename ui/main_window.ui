  </property>
  <property name="windowTitle">
   <string>UNSW-NB15 - Mineria de Datos (CRISP-DM)</string>
  </property>
  <widget class="QWidget" name="centralwidget">
   <layout class="QVBoxLayout" name="layout_principal">
    <item>
     <widget class="QTabWidget" name="tab_crisp">
      <property name="currentIndex">
       <number>0</number>
      </property>

      <!-- PESTANA 1: ENTENDIMIENTO DEL NEGOCIO -->
      <widget class="QWidget" name="tab_negocio">
       <attribute name="title">
        <string>1. Entendimiento del Negocio</string>
