      <!-- PESTANA 4: MODELADO -->
      <widget class="QWidget" name="tab_modelado">
       <attribute name="title">
        <string>4. Modelado</string>
       </attribute>
       <layout class="QVBoxLayout" name="layout_modelado">
        <item>
         <widget class="QGroupBox" name="grp_config_modelo">
          <property name="title">
           <string>Configuracion de Algoritmo y Validacion</string>
          </property>
          <layout class="QFormLayout" name="form_modelado">
           <item row="0" column="0">
            <widget class="QLabel" name="lbl_modelo">
             <property name="text">
              <string>Algoritmo:</string>
             </property>
            </widget>
           </item>
           <item row="0" column="1">
            <widget class="QComboBox" name="cmb_modelo">
             <item>
              <property name="text">
               <string>Regresion Logistica</string>
              </property>
             </item>
