          </item>
          <item>
           <widget class="QPushButton" name="btn_buscar_train">
            <property name="text">
             <string>...</string>
            </property>
            <property name="maximumWidth">
             <number>34</number>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QLabel" name="lbl_test">
            <property name="text">
             <string>Test CSV:</string>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QLineEdit" name="txt_ruta_test">
            <property name="text">
             <string>data/UNSW_NB15_testing-set.csv</string>
            </property>
