            <property name="text">
             <string>Cargar e Integrar</string>
            </property>
           </widget>
          </item>
         </layout>
        </item>

        <item>
         <widget class="QLabel" name="lbl_resumen_datos">
          <property name="text">
           <string>Sin datos cargados. Presiona "Cargar e Integrar".</string>
          </property>
         </widget>
        </item>

        <item>
         <layout class="QHBoxLayout" name="layout_datos_medio" stretch="3,2">
          <item>
           <widget class="QGroupBox" name="grp_preview">
            <property name="title">
